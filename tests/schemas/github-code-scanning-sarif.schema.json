{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://docs.github.com/code-security/code-scanning/integrating-with-code-scanning/sarif-output",
  "title": "GitHub Code Scanning SARIF 2.1.0 subset",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "runs"
  ],
  "properties": {
    "$schema": {
      "const": "https://json.schemastore.org/sarif-2.1.0.json"
    },
    "version": {
      "const": "2.1.0"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "results"
        ],
        "properties": {
          "tool": {
            "type": "object",
            "required": [
              "driver"
            ],
            "properties": {
              "driver": {
                "type": "object",
                "required": [
                  "name",
                  "rules"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "informationUri": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "shortDescription",
                        "fullDescription",
                        "defaultConfiguration"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string"
                        },
                        "shortDescription": {
                          "$ref": "#/$defs/message"
                        },
                        "fullDescription": {
                          "$ref": "#/$defs/message"
                        },
                        "defaultConfiguration": {
                          "type": "object",
                          "required": [
                            "level"
                          ],
                          "properties": {
                            "level": {
                              "$ref": "#/$defs/level"
                            }
                          }
                        },
                        "help": {
                          "$ref": "#/$defs/message"
                        },
                        "properties": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ruleId",
                "level",
                "message",
                "locations"
              ],
              "properties": {
                "ruleId": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "$ref": "#/$defs/level"
                },
                "message": {
                  "$ref": "#/$defs/message"
                },
                "locations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "physicalLocation"
                    ],
                    "properties": {
                      "physicalLocation": {
                        "type": "object",
                        "required": [
                          "artifactLocation"
                        ],
                        "properties": {
                          "artifactLocation": {
                            "type": "object",
                            "required": [
                              "uri"
                            ],
                            "properties": {
                              "uri": {
                                "type": "string",
                                "minLength": 1
                              },
                              "uriBaseId": {
                                "type": "string"
                              }
                            }
                          },
                          "region": {
                            "type": "object",
                            "properties": {
                              "startLine": {
                                "type": "number",
                                "minimum": 1
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "level": {
      "enum": [
        "note",
        "warning",
        "error"
      ]
    },
    "message": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
